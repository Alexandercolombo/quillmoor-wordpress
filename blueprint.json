{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "preferredVersions": { "php": "8.3", "wp": "latest" },
  "features": { "networking": true },
  "login": true,
  "steps": [
    {
      "step": "installTheme",
      "themeData": { "resource": "git:directory", "url": "https://github.com/Alexandercolombo/quillmoor-wordpress", "ref": "main", "path": "wp-content/themes/quillmoor" },
      "options": { "activate": true }
    },
    {
      "step": "installPlugin",
      "pluginData": { "resource": "git:directory", "url": "https://github.com/Alexandercolombo/quillmoor-wordpress", "ref": "main", "path": "wp-content/plugins/quillmoor-core" },
      "options": { "activate": true }
    },
    {
      "step": "runPHP",
      "code": "<?php define( 'QUILLMOOR_FAST_SEED', true ); require '/wordpress/wp-load.php'; require WP_PLUGIN_DIR . '/quillmoor-core/demo/seed.php';"
    }
  ]
}
